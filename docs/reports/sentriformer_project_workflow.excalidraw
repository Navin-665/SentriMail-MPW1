    {"id":"title","type":"text","x":90,"y":55,"width":1880,"height":55,"angle":0,"strokeColor":"#1f2937","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"SentriMail / SentriFormer — Project Workflow and Key Results","fontSize":32,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"SentriMail / SentriFormer — Project Workflow and Key Results","autoResize":true,"lineHeight":1.25,"seed":1001,"version":1,"versionNonce":1001,"isDeleted":false,"groupIds":[]},
    {"id":"subtitle","type":"text","x":92,"y":112,"width":1900,"height":30,"angle":0,"strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"Training and deployment path — metrics are taken from the repository reports","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Training and deployment path — metrics are taken from the repository reports","autoResize":true,"lineHeight":1.25,"seed":1002,"version":1,"versionNonce":1002,"isDeleted":false,"groupIds":[]},

    {"id":"s1","type":"rectangle","x":80,"y":190,"width":330,"height":280,"angle":0,"strokeColor":"#7c3aed","backgroundColor":"#ede9fe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":1101,"version":1,"versionNonce":1101,"isDeleted":false,"groupIds":[]},
    {"id":"s1t","type":"text","x":102,"y":212,"width":285,"height":235,"angle":0,"strokeColor":"#312e81","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"1. Raw support data\n\n• CFPB complaints\n• Twitter Customer Support\n• Bitext + e-commerce\n• GoEmotions supplement\n\nRESULT\nMultiple text, intent, response, and CSAT signals","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Raw support data\n\n• CFPB complaints\n• Twitter Customer Support\n• Bitext + e-commerce\n• GoEmotions supplement\n\nRESULT\nMultiple text, intent, response, and CSAT signals","autoResize":true,"lineHeight":1.25,"seed":1102,"version":1,"versionNonce":1102,"isDeleted":false,"groupIds":[]},

    {"id":"s2","type":"rectangle","x":500,"y":190,"width":330,"height":280,"angle":0,"strokeColor":"#2563eb","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":1201,"version":1,"versionNonce":1201,"isDeleted":false,"groupIds":[]},
    {"id":"s2t","type":"text","x":522,"y":212,"width":285,"height":235,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"2. Curate + split\n\n• Distill pseudo-labels\n• Deduplicate + English filter\n• Stratified 80/10/10 split\n• Save checkpointed Parquet\n\nRESULT\n3.54M-record corpus; leakage-controlled train / val / test","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"2. Curate + split\n\n• Distill pseudo-labels\n• Deduplicate + English filter\n• Stratified 80/10/10 split\n• Save checkpointed Parquet\n\nRESULT\n3.54M-record corpus; leakage-controlled train / val / test","autoResize":true,"lineHeight":1.25,"seed":1202,"version":1,"versionNonce":1202,"isDeleted":false,"groupIds":[]},

    {"id":"s3","type":"rectangle","x":920,"y":190,"width":330,"height":280,"angle":0,"strokeColor":"#0891b2","backgroundColor":"#cffafe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":1301,"version":1,"versionNonce":1301,"isDeleted":false,"groupIds":[]},
    {"id":"s3t","type":"text","x":942,"y":212,"width":285,"height":235,"angle":0,"strokeColor":"#164e63","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"3. Tokenizer + model\n\n• SentriTokenizer BPE\n• 16k vocabulary\n• SentriFormer encoder-decoder\n• SDPA + tied embeddings\n\nRESULT\nReusable ~11.45M-parameter backbone for downstream heads","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3. Tokenizer + model\n\n• SentriTokenizer BPE\n• 16k vocabulary\n• SentriFormer encoder-decoder\n• SDPA + tied embeddings\n\nRESULT\nReusable ~11.45M-parameter backbone for downstream heads","autoResize":true,"lineHeight":1.25,"seed":1302,"version":1,"versionNonce":1302,"isDeleted":false,"groupIds":[]},

    {"id":"s4","type":"rectangle","x":1340,"y":190,"width":330,"height":280,"angle":0,"strokeColor":"#0f766e","backgroundColor":"#ccfbf1","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":1401,"version":1,"versionNonce":1401,"isDeleted":false,"groupIds":[]},
    {"id":"s4t","type":"text","x":1362,"y":212,"width":285,"height":235,"angle":0,"strokeColor":"#134e4a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"4. Backbone pretraining\n\n• 3 full epochs\n• 149,292 steps / 14.79 h\n• Monitor loss, VRAM, gradients\n\nRESULT\nBest val loss 2.4248; test PPL 10.27; generalization gap 0.335","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"4. Backbone pretraining\n\n• 3 full epochs\n• 149,292 steps / 14.79 h\n• Monitor loss, VRAM, gradients\n\nRESULT\nBest val loss 2.4248; test PPL 10.27; generalization gap 0.335","autoResize":true,"lineHeight":1.25,"seed":1402,"version":1,"versionNonce":1402,"isDeleted":false,"groupIds":[]},

    {"id":"parallel","type":"text","x":92,"y":535,"width":1550,"height":35,"angle":0,"strokeColor":"#475569","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"5. Downstream specialization — trained from the shared backbone","fontSize":22,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"5. Downstream specialization — trained from the shared backbone","autoResize":true,"lineHeight":1.25,"seed":1500,"version":1,"versionNonce":1500,"isDeleted":false,"groupIds":[]},

    {"id":"s5a","type":"rectangle","x":80,"y":590,"width":440,"height":300,"angle":0,"strokeColor":"#d97706","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":1501,"version":1,"versionNonce":1501,"isDeleted":false,"groupIds":[]},
    {"id":"s5at","type":"text","x":104,"y":612,"width":392,"height":255,"angle":0,"strokeColor":"#78350f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"5A. Intent classification\n\n33-class category head\n\nRESULT\n79.15% test accuracy\n78.87% weighted F1\n123,229 unseen test samples\nSupports department routing","fontSize":19,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"5A. Intent classification\n\n33-class category head\n\nRESULT\n79.15% test accuracy\n78.87% weighted F1\n123,229 unseen test samples\nSupports department routing","autoResize":true,"lineHeight":1.25,"seed":1502,"version":1,"versionNonce":1502,"isDeleted":false,"groupIds":[]},

    {"id":"s5b","type":"rectangle","x":600,"y":590,"width":440,"height":300,"angle":0,"strokeColor":"#db2777","backgroundColor":"#fce7f3","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":1511,"version":1,"versionNonce":1511,"isDeleted":false,"groupIds":[]},
    {"id":"s5bt","type":"text","x":624,"y":612,"width":392,"height":255,"angle":0,"strokeColor":"#831843","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"5B. CSAT prediction\n\n1–5 star ordinal head\n\nRESULT\n72.07% exact accuracy\n81.49% within ±1 star\nMAE 0.7310\nFlags dissatisfaction for triage","fontSize":19,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"5B. CSAT prediction\n\n1–5 star ordinal head\n\nRESULT\n72.07% exact accuracy\n81.49% within ±1 star\nMAE 0.7310\nFlags dissatisfaction for triage","autoResize":true,"lineHeight":1.25,"seed":1512,"version":1,"versionNonce":1512,"isDeleted":false,"groupIds":[]},

    {"id":"s5c","type":"rectangle","x":1120,"y":590,"width":440,"height":300,"angle":0,"strokeColor":"#dc2626","backgroundColor":"#fee2e2","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":1521,"version":1,"versionNonce":1521,"isDeleted":false,"groupIds":[]},
    {"id":"s5ct","type":"text","x":1144,"y":612,"width":392,"height":255,"angle":0,"strokeColor":"#7f1d1d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"5C. Dialogue SFT\n\nContext → support response\n\nRESULT\nTest PPL 8.94\nBut 73.3% Twitter-artifact contamination\nEnterprise score 48.7 / 100\nTriggers clean-response alignment","fontSize":19,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"5C. Dialogue SFT\n\nContext → support response\n\nRESULT\nTest PPL 8.94\nBut 73.3% Twitter-artifact contamination\nEnterprise score 48.7 / 100\nTriggers clean-response alignment","autoResize":true,"lineHeight":1.25,"seed":1522,"version":1,"versionNonce":1522,"isDeleted":false,"groupIds":[]},

    {"id":"s6","type":"rectangle","x":730,"y":1010,"width":620,"height":300,"angle":0,"strokeColor":"#4f46e5","backgroundColor":"#e0e7ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":1601,"version":1,"versionNonce":1601,"isDeleted":false,"groupIds":[]},
    {"id":"s6t","type":"text","x":758,"y":1032,"width":564,"height":255,"angle":0,"strokeColor":"#312e81","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"6. Unified multi-task calibration\n\nCategory + CSAT + live response generation\nLoss weights: 1.0 × category + 0.1 × CSAT + 0.5 × dialogue\n\nRESULT\n73.28% category accuracy\n81.72% CSAT within ±1 star\nPPL 1.04 exposed as decoder mode-collapse / artifact, not real dialogue quality","fontSize":20,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"6. Unified multi-task calibration\n\nCategory + CSAT + live response generation\nLoss weights: 1.0 × category + 0.1 × CSAT + 0.5 × dialogue\n\nRESULT\n73.28% category accuracy\n81.72% CSAT within ±1 star\nPPL 1.04 exposed as decoder mode-collapse / artifact, not real dialogue quality","autoResize":true,"lineHeight":1.25,"seed":1602,"version":1,"versionNonce":1602,"isDeleted":false,"groupIds":[]},

    {"id":"s7","type":"rectangle","x":730,"y":1430,"width":620,"height":350,"angle":0,"strokeColor":"#059669","backgroundColor":"#d1fae5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":1701,"version":1,"versionNonce":1701,"isDeleted":false,"groupIds":[]},
    {"id":"s7t","type":"text","x":758,"y":1452,"width":564,"height":305,"angle":0,"strokeColor":"#064e3b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"7. Clean-response alignment + safety gates\n\n• Remove handles, URLs, signatures, phone leaks, DM deflections\n• Add 4-tier enterprise response templates\n• Add resolution-grounded M10.4 examples\n• Fix causal mask, explicit EOS, and generation suppression\n\nRESULT\n80-inquiry audit: contamination 87.5% → 0%; EOS termination 100%; fluency 93.5%; clean-SFT test PPL 14.79","fontSize":19,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"7. Clean-response alignment + safety gates\n\n• Remove handles, URLs, signatures, phone leaks, DM deflections\n• Add 4-tier enterprise response templates\n• Add resolution-grounded M10.4 examples\n• Fix causal mask, explicit EOS, and generation suppression\n\nRESULT\n80-inquiry audit: contamination 87.5% → 0%; EOS termination 100%; fluency 93.5%; clean-SFT test PPL 14.79","autoResize":true,"lineHeight":1.25,"seed":1702,"version":1,"versionNonce":1702,"isDeleted":false,"groupIds":[]},

    {"id":"s8","type":"rectangle","x":730,"y":1900,"width":620,"height":340,"angle":0,"strokeColor":"#7c3aed","backgroundColor":"#f3e8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":1801,"version":1,"versionNonce":1801,"isDeleted":false,"groupIds":[]},
    {"id":"s8t","type":"text","x":758,"y":1922,"width":564,"height":294,"angle":0,"strokeColor":"#4c1d95","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"8. SentriMail application workflow\n\nComplaint intake → language detection / translation\n→ sentiment + emotion + priority + root cause\n→ low-risk auto-response OR admin escalation\n→ status update, email reply, tracking code\n\nRESULT\nOperational ticket routing with human-in-the-loop safeguards; MongoDB with local JSON fallback","fontSize":19,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"8. SentriMail application workflow\n\nComplaint intake → language detection / translation\n→ sentiment + emotion + priority + root cause\n→ low-risk auto-response OR admin escalation\n→ status update, email reply, tracking code\n\nRESULT\nOperational ticket routing with human-in-the-loop safeguards; MongoDB with local JSON fallback","autoResize":true,"lineHeight":1.25,"seed":1802,"version":1,"versionNonce":1802,"isDeleted":false,"groupIds":[]},

    {"id":"note","type":"text","x":1420,"y":1445,"width":500,"height":230,"angle":0,"strokeColor":"#475569","backgroundColor":"#f8fafc","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"Decision gate\n\nM10.2: PASS with behavioral limitations documented.\n\nKnown limitation: low-confidence category routing needs a production fallback below 25% confidence.\n\nNext direction: clean-response refinement and preference tuning / DPO.","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Decision gate\n\nM10.2: PASS with behavioral limitations documented.\n\nKnown limitation: low-confidence category routing needs a production fallback below 25% confidence.\n\nNext direction: clean-response refinement and preference tuning / DPO.","autoResize":true,"lineHeight":1.25,"seed":1901,"version":1,"versionNonce":1901,"isDeleted":false,"groupIds":[]},

